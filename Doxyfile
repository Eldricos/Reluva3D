# Doxygen's settings for Reluva's API pages: `doxygen` from the repository's
# top writes them to build-docs/html/. tools/check-doxygen.py runs it and
# lists the public classes and functions in headers that have no block
# (docs/CODING_GUIDE.md, Documentation). Settings left out are Doxygen's
# defaults.

PROJECT_NAME           = Reluva
OUTPUT_DIRECTORY       = build-docs
STRIP_FROM_PATH        = src
STRIP_FROM_INC_PATH    = src
FULL_PATH_NAMES        = YES

# The guide's blocks start with a sentence, which serves as the brief.
JAVADOC_AUTOBRIEF      = YES
MULTILINE_CPP_IS_BRIEF = NO

# One block before a ///@{ ... ///@} group of members serves each of them
# (readLE16, readLE32...).
DISTRIBUTE_GROUP_DOC   = YES

# Only headers carry the API's blocks; newworlds is left out of the build
# (engines.cfg) and third_party/ isn't Reluva's.
INPUT                  = src
FILE_PATTERNS          = *.h
RECURSIVE              = YES
EXCLUDE                = src/engines/newworlds
EXCLUDE_SYMBOLS        = detail
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
INTERNAL_DOCS          = NO

ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
INCLUDE_PATH           = src
PREDEFINED             = RELUVA_DEVELOPER_KEYS=1 \
                         "RELUVA_FORCE_INLINE=inline" \
                         "RELUVA_PRINTF(fmt,args)="

# The guide asks for @param and @return only where they add something, so
# blocks that leave some out aren't incomplete.
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC = NO
WARN_NO_PARAMDOC       = NO
WARN_FORMAT            = "$file:$line: $text"
WARN_LOGFILE           = build-docs/warnings.txt

GENERATE_HTML          = YES
GENERATE_LATEX         = NO
HAVE_DOT               = NO
SOURCE_BROWSER         = NO
SEARCHENGINE           = YES
