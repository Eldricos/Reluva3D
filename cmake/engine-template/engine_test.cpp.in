// @TITLE@ as a whole, without any game's files: the basic engine test, run
// by ctest and CI. It makes a small install of its own, takes the engine
// through what playing does, and writes what happens into a record (counts,
// checksums: tests/support/record.h), compared with
// tests/engines/@ENGINE@/data/engine-record.txt.
//
//   reluva-tests @ENGINE@.engine [--update]
//
// So far it only checks the install isn't taken for a game: add steps as
// the engine learns to read and run its games (see
// tests/engines/idtech3/engine.cpp), then --update and review the record.

#include "engines/registry.h"

#include "tests/support/record.h"
#include "tests/support/test.h"

using namespace reluva;

namespace {

void engineTest(const std::filesystem::path& tmp) {
    const std::filesystem::path dir = tmp / "install";
    std::filesystem::create_directories(dir);
    test::Record rec;
    const MetaEngine* engine = findEngine("@ENGINE@");
    if (!engine)
        return test::fail("@ENGINE@ isn't registered");
    rec.add("detect.games", static_cast<int64_t>(engine->detect(dir).size()));
    rec.check(RELUVA_SOURCE_DIR "/tests/engines/@ENGINE@/data/engine-record.txt", "@ENGINE@.engine",
              "tests/engines/@ENGINE@/engine.cpp");
}

} // namespace

static const reluva::test::Suite suite("@ENGINE@.engine", {
    {"play through", [](const std::filesystem::path& tmp) { engineTest(tmp); }},
});
