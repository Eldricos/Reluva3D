include("${HELPERS}")
gamedata_begin("the install or expanded CD folder containing Boggle.exe")

# The shared harness normally writes full output inside the build tree.
# Keep this engine's research output outside every Git worktree instead.
if("$ENV{RELUVA_BOGGLE_ANALYSIS}" STREQUAL "" OR NOT IS_ABSOLUTE "$ENV{RELUVA_BOGGLE_ANALYSIS}")
    message(FATAL_ERROR "Set RELUVA_BOGGLE_ANALYSIS to an absolute output directory outside Git worktrees")
endif()
file(REAL_PATH "$ENV{RELUVA_BOGGLE_ANALYSIS}" analysis)
file(REAL_PATH "${CMAKE_CURRENT_LIST_DIR}/../../.." source_root)
cmake_path(IS_PREFIX source_root "${analysis}" NORMALIZE inside_source)
if(inside_source)
    message(FATAL_ERROR "RELUVA_BOGGLE_ANALYSIS must be outside the repository, including its build folders")
endif()
set(ancestor "${analysis}")
while(NOT IS_DIRECTORY "${ancestor}")
    get_filename_component(parent "${ancestor}" DIRECTORY)
    if(parent STREQUAL ancestor)
        message(FATAL_ERROR "Cannot locate an existing parent for analysis output")
    endif()
    set(ancestor "${parent}")
endwhile()
find_program(git_program git REQUIRED)
execute_process(COMMAND "${git_program}" -C "${ancestor}" rev-parse --is-inside-work-tree
    OUTPUT_VARIABLE in_git ERROR_QUIET OUTPUT_STRIP_TRAILING_WHITESPACE)
if(in_git STREQUAL "true")
    message(FATAL_ERROR "RELUVA_BOGGLE_ANALYSIS is inside a Git worktree")
endif()
set(OUTPUT "${analysis}")
run_tool(detection detect "${game_dir}")
if(NOT detection MATCHES "^boggle/boggle1997:")
    message(FATAL_ERROR "Not the supported Boggle file set")
endif()
if(STEP STREQUAL "release")
    record_run(release "boggle/boggle1997:" detect "${game_dir}")
elseif(STEP STREQUAL "resources")
    record_run(resources "decoded resources:" boggle resource-check "${game_dir}")
elseif(STEP STREQUAL "dictionaries")
    record_run(dictionaries "decoded dictionaries:" boggle dictionary-check "${game_dir}")
elseif(STEP STREQUAL "classic")
    record_run(classic "decoded Classic:" boggle classic-check "${game_dir}")
elseif(STEP STREQUAL "master")
    record_run(master "decoded Classic:" boggle classic-check "${game_dir}" master)
elseif(STEP STREQUAL "presentation")
    record_run(presentation "decoded presentation:" boggle presentation-check "${game_dir}")
elseif(STEP STREQUAL "music")
    record_run(music "decoded music:" boggle music-check "${game_dir}")
elseif(STEP STREQUAL "movies")
    record_run(movies "decoded movies:" boggle movie-check "${game_dir}")
elseif(STEP STREQUAL "allwords")
    record_run(allwords "decoded all words:" boggle all-words-check "${game_dir}")
elseif(STEP STREQUAL "computer")
    record_run(computer "decoded computers:" boggle computer-check "${game_dir}")
elseif(STEP STREQUAL "competition")
    record_run(competition "decoded competitions:" boggle competition-check "${game_dir}")
elseif(STEP STREQUAL "font")
    record_run(font "decoded font:" boggle font-check "${game_dir}")
elseif(STEP STREQUAL "artwork")
    record_run(artwork "decoded artwork:" boggle artwork-check "${game_dir}")
elseif(STEP STREQUAL "frontend")
    record_run(frontend "decoded frontend:" boggle frontend-check "${game_dir}")
elseif(STEP STREQUAL "import")
    # All copies stay in the already validated external analysis directory.
    string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef import_id)
    set(imported "${analysis}/classic-import-${import_id}")
    if(EXISTS "${imported}")
        message(FATAL_ERROR "Import test destination already exists")
    endif()
    record_run(plan "decoded import:" boggle import-check "${game_dir}")
    run_tool(before boggle import-check "${game_dir}")
    run_tool(copy import "${game_dir}" "${imported}")
    file(WRITE "${analysis}/import/copy.txt" "${copy}")
    run_tool(after boggle import-check "${imported}")
    if(NOT before STREQUAL after)
        message(FATAL_ERROR "Imported file set differs from source")
    endif()
    record_run(original "decoded Classic:" boggle classic-check "${imported}")
    record_run(master "decoded Classic:" boggle classic-check "${imported}" master)
    record_run(presentation "decoded presentation:" boggle presentation-check "${imported}")
    record_run(music "decoded music:" boggle music-check "${imported}")
    record_run(frontend "decoded frontend:" boggle frontend-check "${imported}")
    record_run(movies "decoded movies:" boggle movie-check "${imported}")
    record_run(artwork "decoded artwork:" boggle artwork-check "${imported}")
    record_run(font "decoded font:" boggle font-check "${imported}")
    record_run(allwords "decoded all words:" boggle all-words-check "${imported}")
    record_run(competition "decoded competitions:" boggle competition-check "${imported}")
    record_run(computer "decoded computers:" boggle computer-check "${imported}")
    file(REMOVE_RECURSE "${imported}")
else()
    message(FATAL_ERROR "Unknown Boggle game-data step: ${STEP}")
endif()
gamedata_end("Boggle supplied multilingual file set" "supplied-multilingual")
